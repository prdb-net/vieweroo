#!/usr/bin/env python3
"""Prepare and launch a persistent, checkout-local Vieweroo test app."""
import fcntl
import plistlib
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
from fixtures.generate import generate


def launch(repo):
    profile = repo / ".local" / "test-library"
    profile.mkdir(parents=True, exist_ok=True)
    app = profile / "Vieweroo Test Library.app"
    with (profile / ".launch.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not subprocess.check_output(["lsappinfo", "find", f"bundlepath={app}"]).strip():
            generate(profile)
            build_app(repo, app)
        subprocess.run(["open", str(app)], check=True)


def build_app(repo, app):
    build = [repo / "scripts/build-product", "--configuration", "debug"]
    binaries = Path(subprocess.check_output(build, cwd=repo, text=True).strip())
    with tempfile.TemporaryDirectory(dir=app.parent) as stage:
        bundle = Path(stage) / app.name
        contents = bundle / "Contents"
        (contents / "MacOS").mkdir(parents=True)
        resources = contents / "Resources"
        resources.mkdir()
        shutil.copy2(binaries / "Vieweroo", contents / "MacOS" / "Vieweroo")
        shutil.copy2(repo / "Packaging/Vieweroo.icns", resources)
        for resource in binaries.glob("*.bundle"):
            shutil.copytree(resource, resources / resource.name)
        info = plistlib.loads((repo / "Packaging/Info.plist").read_bytes())
        info.update(CFBundleIdentifier="net.prdb.vieweroo.test-library", CFBundleName="Vieweroo Test Library")
        (contents / "Info.plist").write_bytes(plistlib.dumps(info))
        subprocess.run(["codesign", "--force", "--sign", "-", str(bundle)], check=True)
        subprocess.run(["codesign", "--verify", "--strict", str(bundle)], check=True)
        previous = Path(stage) / "previous.app"
        if app.exists():
            app.rename(previous)
        try:
            bundle.rename(app)
        except OSError:
            if previous.exists():
                previous.rename(app)
            raise


if __name__ == "__main__":
    launch(Path(__file__).resolve().parents[1])
