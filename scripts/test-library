#!/usr/bin/env python3
"""Prepare and launch the checkout-local or installed Vieweroo test library."""
import argparse
import fcntl
import plistlib
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
from fixtures.generate import generate


def launch(repo, install):
    bundle_id = "net.prdb.vieweroo.test-library"
    if install:
        bundle_id += ".installed"
        profile = Path.home() / "Library/Application Support" / bundle_id
        applications = Path.home() / "Applications"
    else:
        profile = repo / ".local" / "test-library"
        applications = profile
    profile.mkdir(parents=True, exist_ok=True)
    applications.mkdir(parents=True, exist_ok=True)
    app = applications / "Vieweroo Test Library.app"
    with (profile / ".launch.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if app.exists():
            info = plistlib.loads((app / "Contents/Info.plist").read_bytes())
            if info.get("CFBundleIdentifier") != bundle_id:
                sys.exit(f"Another app already occupies {app}.")
        if not subprocess.check_output(["lsappinfo", "find", f"bundlepath={app}"]).strip():
            generate(profile)
            build_app(repo, app, bundle_id)
        subprocess.run(["open", str(app)], check=True)


def build_app(repo, app, bundle_id):
    build = [repo / "scripts/build-product", "--configuration", "debug"]
    binaries = Path(subprocess.check_output(build, cwd=repo, text=True).strip())
    with tempfile.TemporaryDirectory(dir=app.parent) as stage:
        bundle = Path(stage) / app.name
        contents = bundle / "Contents"
        (contents / "MacOS").mkdir(parents=True)
        resources = contents / "Resources"
        resources.mkdir()
        shutil.copy2(binaries / "Vieweroo", contents / "MacOS" / "Vieweroo")
        shutil.copy2(repo / "Packaging/Vieweroo.icns", resources)
        for resource in binaries.glob("*.bundle"):
            shutil.copytree(resource, resources / resource.name)
        info = plistlib.loads((repo / "Packaging/Info.plist").read_bytes())
        info.update(CFBundleIdentifier=bundle_id, CFBundleName="Vieweroo Test Library")
        (contents / "Info.plist").write_bytes(plistlib.dumps(info))
        subprocess.run(["codesign", "--force", "--sign", "-", str(bundle)], check=True)
        subprocess.run(["codesign", "--verify", "--strict", str(bundle)], check=True)
        previous = Path(stage) / "previous.app"
        if app.exists():
            app.rename(previous)
        try:
            bundle.rename(app)
        except OSError:
            if previous.exists():
                previous.rename(app)
            raise


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--install", action="store_true", help="install or update the test app in ~/Applications")
    launch(Path(__file__).resolve().parents[1], parser.parse_args().install)
